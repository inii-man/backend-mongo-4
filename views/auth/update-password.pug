extends ../layout

block content
  h2 Update Password
  p You must update your password before continuing.
  
  form(action="/auth/update-password" method="post")
    table
      tbody
        tr
          td New Password
          td: input(type="password" name="password" required minlength="8")
        tr
          td(colspan="2")
            input(type="submit" value="Update Password")
